{
    "hyprland/window": { "separate-outputs": true },
    "hyprland/submap": {
        "always-on": true,
        "default-submap": "main",
        "format": "submap: {}"
    },
    "hyprland/language": {
        "format": "layout: {}",
        "on-click": "hyprctl devices | awk '/Keyboard at/ {getline; print}' | xargs -I{} hyprctl switchxkblayout {} next"
    },
    "hyprland/language#short": {
        "format": "{short} ",
        "on-click": "hyprctl devices | awk '/Keyboard at/ {getline; print}' | xargs -I{} hyprctl switchxkblayout {} next"
    },
    "hyprland/workspaces": {
        "format": "{icon} {windows}",
        "workspace-taskbar": {
            "enable": true,
            "format": "{icon}"
        }
    }
}